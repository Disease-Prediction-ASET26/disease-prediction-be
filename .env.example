# Copy this file to .env and set your own values. .env is gitignored, never commit it.
POSTGRES_DB=disease_prediction
POSTGRES_USER=disease_prediction
POSTGRES_PASSWORD=change-me
# Host port for the local database. 5433 avoids clashing with a PostgreSQL already running on 5432.
POSTGRES_PORT=5433
# AES-256 key for field-level encryption of personal data. Generate your own with:
#   openssl rand -base64 32
# The backend refuses to start without it. Losing it makes encrypted data unreadable.
DATA_ENCRYPTION_KEY=
# Local Hanko (compose.yaml). Key that encrypts Hanko's signing keys; at least 16 characters.
# Generate your own with:
#   openssl rand -base64 32
HANKO_SECRETS_KEY=
# Hanko settings for the backend. The defaults in application.properties match the local Hanko,
# so these are only needed to point a local backend at another Hanko (for example the dev instance:
# HANKO_ISSUER=https://identity-dev.pocket-doc.app, HANKO_AUDIENCE=pocket-doc-dev, ...).
# HANKO_ISSUER=http://localhost:8100
# HANKO_JWKS_URI=http://localhost:8100/.well-known/jwks.json
# HANKO_AUDIENCE=pocket-doc-local
# HANKO_API_URL=http://localhost:8100
