# Copy this file to .env and set your own values. .env is gitignored, never commit it.
POSTGRES_DB=disease_prediction
POSTGRES_USER=disease_prediction
POSTGRES_PASSWORD=change-me
# Host port for the local database. 5433 avoids clashing with a PostgreSQL already running on 5432.
POSTGRES_PORT=5433
# AES-256 key for field-level encryption of personal data. Generate your own with:
#   openssl rand -base64 32
# The backend refuses to start without it. Losing it makes encrypted data unreadable.
DATA_ENCRYPTION_KEY=
# Base URL of the Python prediction service (disease-prediction-ai). Leave empty to use the
# backend's stub prediction instead of the real model.
PREDICTION_SERVICE_URL=
